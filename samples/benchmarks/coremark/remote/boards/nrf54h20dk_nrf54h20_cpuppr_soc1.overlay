 / {
	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = < &gpio9 0x09 GPIO_ACTIVE_LOW >;
			label = "Green LED 0";
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = < &gpio9 0x08 (GPIO_PULL_UP | GPIO_ACTIVE_LOW) >;
			label = "Push button 1";
		};
	};

	aliases {
		led = &led0;
		button = &button0;
	};

	soc {
		stmesp: memory@ae000000 {
			compatible = "nordic,allocatable-ram";
			reg = <0xae000000 DT_SIZE_K(16384)>;
			perm-read;
			perm-write;
		};
	};
};

&gpio9 {
	status = "okay";
};

&gpiote130 {
	owned-channels = <2 4>;
	status = "okay";
};
