 / {
	chosen {
		zephyr,console = &uart135;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = < &gpio9 0x09 GPIO_ACTIVE_LOW >;
			label = "Green LED 0";
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = < &gpio9 0x08 (GPIO_PULL_UP | GPIO_ACTIVE_LOW) >;
			label = "Push button 1";
		};
	};

	aliases {
		led = &led0;
		button = &button0;
	};
};

&ram3x {
	ram3x_cpuppr: memory@7c80 {
		compatible = "zephyr,memory-region", "mmio-sram";
		zephyr,memory-region = "DMA_RAM3x_PPR";
		#memory-region-cells = < 0x0 >;
		reg = <0x7c80 0x80>;
	};
};

&uart135 {
	status = "okay";
	memory-regions = <&ram3x_cpuppr>;
	tx-pin = <0x24>;
	rx-pin = <0x25>;
};

&gpio9 {
	status = "okay";
};

&gpiote130 {
	owned-channels = <2 4>;
	status = "okay";
};
